{
  "manifest_version": 3,
  "name": "Shopee Noir",
  "version": "0.1.0",
  "description": "black, quiet, minimal shopee. same ux, less noise.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shopee-noir@iblameraihan.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.shopee.co.id/*",
    "*://*.shopee.com/*",
    "*://*.shopee.sg/*",
    "*://*.shopee.com.my/*",
    "*://*.shopee.ph/*",
    "*://*.shopee.vn/*",
    "*://*.shopee.co.th/*",
    "*://*.shopee.tw/*",
    "*://*.shopee.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.shopee.co.id/*",
        "*://*.shopee.com/*",
        "*://*.shopee.sg/*",
        "*://*.shopee.com.my/*",
        "*://*.shopee.ph/*",
        "*://*.shopee.vn/*",
        "*://*.shopee.co.th/*",
        "*://*.shopee.tw/*",
        "*://*.shopee.com.br/*"
      ],
      "css": [
        "noir.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.shopee.co.id/*",
        "*://*.shopee.com/*",
        "*://*.shopee.sg/*",
        "*://*.shopee.com.my/*",
        "*://*.shopee.ph/*",
        "*://*.shopee.vn/*",
        "*://*.shopee.co.th/*",
        "*://*.shopee.tw/*",
        "*://*.shopee.com.br/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Shopee Noir",
    "default_popup": "popup.html"
  }
}
